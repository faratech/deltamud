# Rust
/target/
**/*.rs.bk

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
# runtime mudlog file (C LOGFILE) — but NOT src/syslog.rs, the source
/syslog
/lib/syslog

# Environment variables
.env
.env.local
.env.*.local

# Runtime files
*.pid
pause
.fastboot
.killscript

# Database files
*.db
*.sqlite
*.sqlite3

# Backup files
*.bak
*.backup
core.*

# Development/testing files
test_*
# Validation byte-compiles the Python gate drivers; keep those generated
# interpreter caches out of release-input status checks.
__pycache__/
*.py[cod]
# The parity protocol regression suite is repository infrastructure, not a
# local scratch test.
!scripts/parity/test_driver.py
debug_*
*.tmp
*.temp

# MUD-specific runtime files
lib/etc/players
lib/plrmail
lib/plrobjs/*
!lib/plrobjs/.gitkeep
log/.claude/
