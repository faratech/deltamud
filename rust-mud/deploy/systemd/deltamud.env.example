# Install as /etc/deltamud/deltamud.env, owned root:deltamud and mode 0640.
# Never commit a populated DATABASE_URL.
DATABASE_URL=mysql://deltamud:CHANGE_ME@127.0.0.1:3306/deltamud
MUD_MOCK_DB=false

# The Rust listener is loopback-only in the hardened deployment. A separately
# reviewed TLS-capable edge proxy may publish it after preserving source IPs.
MUD_BIND=127.0.0.1
MUD_PORT=4000
MUD_METRICS_BIND=127.0.0.1
MUD_METRICS_PORT=19595

# MUD_EXEC_PATH is resolved at copyover time. The release manager changes the
# current symlink only after the target binary and data have passed canary.
MUD_EXEC_PATH=/opt/deltamud/current/bin/deltamud
MUD_LIB_PATH=/var/lib/deltamud/lib
MUD_REVERSE_DNS=true
MUD_REVERSE_DNS_TIMEOUT_MS=1000
MUD_REVERSE_DNS_MAX_INFLIGHT=16
RUST_LOG=info
