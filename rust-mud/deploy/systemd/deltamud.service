[Unit]
Description=DeltaMUD Rust server
Documentation=file:/opt/deltamud/current/docs/RUNBOOK.md
Wants=network-online.target
After=network-online.target mariadb.service
ConditionPathExists=/opt/deltamud/current/bin/deltamud

[Service]
Type=simple
User=deltamud
Group=deltamud
WorkingDirectory=/var/lib/deltamud
EnvironmentFile=/etc/deltamud/deltamud.env
# Never let a stale runtime environment influence the dynamic loader,
# interpreters, or module search path of the root-only activation helpers.
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT LD_DEBUG LD_PROFILE LD_SHOW_AUXV LD_ORIGIN_PATH BASH_ENV ENV SHELLOPTS BASHOPTS CDPATH GLOBIGNORE PYTHONPATH PYTHONHOME PERL5LIB PERLLIB RUBYLIB GEM_HOME GEM_PATH GCONV_PATH GETCONF_DIR HOME XDG_CONFIG_HOME CURL_HOME HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy SYSTEMD_LOG_LEVEL SYSTEMD_LOG_TARGET SYSTEMD_PAGER SYSTEMD_LESS SYSTEMD_COLORS
# The trusted manager consumes one durably journaled candidate-start attempt.
# `+` keeps only these two fixed, root-owned helper invocations privileged;
# the game itself still runs as the unprivileged User/Group below.
ExecCondition=+/usr/local/sbin/deltamud-release activation-guard
ExecStart=/opt/deltamud/current/bin/deltamud
ExecStartPost=+/usr/local/sbin/deltamud-release activation-confirm
Restart=on-failure
# Exit 75 is DeltaMUD's explicit, gracefully-saved restart request. Exit 0 is
# an intentional stop (SIGTERM/Ctrl-C or `shutdown die/pause`) and stays down.
RestartForceExitStatus=75
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=45s
KillSignal=SIGTERM
# A failed OLC flush intentionally cancels shutdown and preserves dirty builder
# state. Never let the service manager turn that recoverable refusal into SIGKILL.
SendSIGKILL=no
UMask=0027

# The game needs its state directory and network sockets, but no privilege,
# device, kernel, home-directory, or executable-memory access.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
ReadOnlyPaths=/opt/deltamud
# This directory is root:root 0700: writable to the privileged confirmation
# helper, but inaccessible to the unprivileged game process.
ReadWritePaths=/var/lib/deltamud -/etc/deltamud/activation
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
